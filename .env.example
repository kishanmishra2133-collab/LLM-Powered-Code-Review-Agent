# Google Gemini API key (Required for running code reviews)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional: unlocks private repos and increases API rate limit)
GITHUB_TOKEN=your_github_token_here

# Daily dollar budget cap for the web demo (Default: 5.0)
DAILY_BUDGET_USD=5.0

# Directory for review cache (Default: data/cache)
CACHE_DIR=data/cache
